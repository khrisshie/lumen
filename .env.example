# Lumen reaches an AI model in one of three ways:
#
# 1. Claude Code CLI (default when no API key is set): runs `claude -p` with your
#    Claude Code login. Nothing to configure if `claude` works in your terminal.
# CLAUDE_BIN=claude              # path to the claude binary, if not on PATH
# LUMEN_MODEL=opus               # optional model override (default: your Claude Code default)
# LUMEN_DATA_DIR=~/.lumen        # where uploaded PDFs and session ids are kept
#
# 2. Claude API: set a key and Lumen uses the API directly.
# ANTHROPIC_API_KEY=sk-ant-...
#
# 3. Codex CLI: runs `codex exec` with your Codex (ChatGPT) login. Used when
#    Claude Code isn't installed, or when LUMEN_BACKEND=codex.
# CODEX_BIN=codex                # path to the codex binary, if not on PATH
# LUMEN_CODEX_MODEL=             # optional model override (default: Codex's default)
#
# Pick one explicitly (default: api if a key is set, else claude, else codex):
# LUMEN_BACKEND=claude           # api | claude | codex
